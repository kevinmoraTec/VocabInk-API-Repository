NODE_ENV=development
PORT=3000

# Create this PostgreSQL database before running migrations.
DATABASE_URL=postgres://postgres:replace_me@localhost:5432/lingoloop_db

# Both OAuth strategies are registered at startup.
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/v1/auth/google/callback
LINKEDIN_CLIENT_ID=replace_with_linkedin_client_id
LINKEDIN_CLIENT_SECRET=replace_with_linkedin_client_secret
LINKEDIN_CALLBACK_URL=http://localhost:3000/v1/auth/linkedin/callback

GOOGLE_API_KEY=replace_with_gemini_api_key
# Generate a random value: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_random_secret
JWT_EXPIRATION=7d
FRONTEND_URL=http://localhost:8080
